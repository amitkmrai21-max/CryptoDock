+# ==========================================
+# SERVER-SIDE PAPER TRADING ENGINE (Per-Email)
+# ==========================================
+import os
+PAPER_FILE = "/var/www/CryptoDock/paper_portfolios.json"
+_paper_lock = threading.Lock()
+
+def _load_portfolios():
+    if not os.path.exists(PAPER_FILE):
+        return {}
+    try:
+        with open(PAPER_FILE, 'r', encoding='utf-8') as f:
+            return json.load(f)
+    except Exception:
+        return {}
+
+def _save_portfolios(data):
+    with open(PAPER_FILE, 'w', encoding='utf-8') as f:
+        json.dump(data, f, indent=2)
+
+def _get_user_portfolio(email):
+    email = (email or '').strip().lower()
+    if not email:
+        raise HTTPException(status_code=401, detail="Please sign in to access paper trading.")
+    with _paper_lock:
+        ports = _load_portfolios()
+        if email not in ports:
+            ports[email] = {
+                "cash": 10000.0,
+                "holdings": {},
+                "orders": [],
+                "realized": 0.0,
+                "created_at": time.time()
+            }
+            _save_portfolios(ports)
+        return ports[email]
+
+@app.get("/api/paper/portfolio")
+async def get_paper_portfolio(email: str):
+    email = email.strip().lower()
+    if not email:
+        raise HTTPException(status_code=401, detail="Sign in required")
+    port = _get_user_portfolio(email)
+    return port
+
+@app.post("/api/paper/sync")
+async def sync_paper_portfolio(request: Request):
+    data = await request.json()
+    email = (data.get("email") or "").strip().lower()
+    if not email:
+        raise HTTPException(status_code=401, detail="Sign in required")
+    state = data.get("state")
+    if not state or not isinstance(state, dict):
+        raise HTTPException(status_code=400, detail="Invalid state")
+    with _paper_lock:
+        ports = _load_portfolios()
+        ports[email] = {
+            "cash": float(state.get("cash", 10000.0)),
+            "holdings": state.get("holdings", {}),
+            "orders": state.get("orders", [])[:50],
+            "realized": float(state.get("realized", 0.0)),
+            "updated_at": time.time()
+        }
+        _save_portfolios(ports)
+    return {"ok": True, "portfolio": ports[email]}
+
+@app.post("/api/paper/reset")
+async def reset_paper_portfolio(request: Request):
+    data = await request.json()
+    email = (data.get("email") or "").strip().lower()
+    if not email:
+        raise HTTPException(status_code=401, detail="Sign in required")
+    with _paper_lock:
+        ports = _load_portfolios()
+        ports[email] = {
+            "cash": 10000.0,
+            "holdings": {},
+            "orders": [],
+            "realized": 0.0,
+            "updated_at": time.time()
+        }
+        _save_portfolios(ports)
+    return {"ok": True, "portfolio": ports[email]}
